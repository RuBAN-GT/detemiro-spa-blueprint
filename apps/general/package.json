{
  "name": "detemiro-spa-app",
  "version": "1.0.0",
  "description": "The general entrypoint of SPA.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "modern start",
    "start:dev": "modern dev",
