    "@swc/helpers": "^0.5.23",
    "detemiro-logger": "^2.5.0",
    "detemiro-logger-browser": "^2.5.0",
    "detemiro-logger-node": "^2.5.0",
    "i18next": "^26.4.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16"
  },
  "devDependencies": {
    "@modern-js/app-tools": "3.9.3",
